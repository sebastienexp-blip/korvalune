{
  "name": "korvalune-pc",
  "version": "1.0.0",
  "description": "Korvalune — application PC",
  "main": "main.js",
  "scripts": { "start": "electron .", "build": "electron-builder --win nsis" },
  "devDependencies": { "electron": "^33.0.0", "electron-builder": "^25.0.0" },
  "build": {
    "appId": "fr.korvalune.pc",
    "productName": "Korvalune",
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true },
    "files": ["main.js", "package.json"]
  }
}
